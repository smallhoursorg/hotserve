#!/bin/sh
# Installs the hotserve the workflow checks with: each release's bare
# binary for this Linux machine's architecture (amd64 or arm64), verified
# against the release's checksums.txt, as /usr/local/bin/hotserve-<version>
# for every release this repository's boxes need, and the default one as
# /usr/local/bin/hotserve too. Which releases:
#
#   - the default, hotserve: HOTSERVE_VERSION (the repository variable,
#     e.g. 0.3.0 or 0.3.0-rc1) when it is set, else the latest stable
#     one. A box with no HOTSERVE_VERSION file is checked with it;
#   - each box's own: <host>/HOTSERVE_VERSION beside its Caddyfile, one
#     line of the same shape, pins that box to a release of its own (the
#     one it runs: a candidate on one box, the stable release on the
#     rest). bin/check runs that box's files with hotserve-<version>.
#
# Each release is downloaded once however many boxes name it. The
# default is installed or nothing is. A box's file that does not name a
# release — empty, two lines, 0.3, a bare v — or names one that has no
# build to download is said here, naming the file, and skipped, so that
# the other boxes are still checked: bin/check then refuses that box,
# naming the file again. Neither ever reads such a file as the latest.
# Each box validates what it is sent with its own binary whatever this
# installs, so this is only the early check.
#
#   bin/install-hotserve           every release the repository needs
#   bin/install-hotserve default   the default alone: the apply job's,
#                                  which reads each box's address and
#                                  nothing else
#
# For the workflow: it installs with sudo. On a laptop, take the
# release's tarball from its page.
set -eu
cd "$(dirname "$0")/.."

case ${1:-} in
'') boxes=1 ;;
default) boxes= ;;
*) echo "install-hotserve: '$1'? bin/install-hotserve installs every release the boxes need; bin/install-hotserve default the default alone" >&2; exit 1 ;;
esac

# The releases ship linux/amd64 and linux/arm64 binaries only.
[ "$(uname -s)" = Linux ] || { echo "install-hotserve: hotserve releases are Linux binaries; this is $(uname -s)" >&2; exit 1; }
case $(uname -m) in
x86_64 | amd64) arch=amd64 ;;
aarch64 | arm64) arch=arm64 ;;
*) echo "install-hotserve: no hotserve release for $(uname -m): amd64 and arm64 only" >&2; exit 1 ;;
esac

# release <value>: whether it is a release's version, v or no v. Nothing
# outside the set (a newline included) before the shape check, which
# grep makes per line. bin/check reads a box's file by the same rule,
# and both take the leading v off only after the check, so a pin of
# just "v" is refused rather than read as no pin.
release() {
	case $1 in '' | *[!0-9A-Za-z.-]*) return 1 ;; esac
	printf '%s\n' "$1" | grep -Eqx 'v?[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?'
}
# not_release <value> <where it came from>: the refusal, one sentence.
not_release() {
	hint=
	[ -n "$1" ] || hint="; an empty file pins nothing: name a release, or delete it"
	echo "install-hotserve: not a hotserve release: '$1' (from $2): a release's version, 0.3.1 or v0.3.1-rc1, on one line$hint" >&2
}

v=${HOTSERVE_VERSION:-}
from=HOTSERVE_VERSION
if [ -z "$v" ]; then
	# Where the latest release's page redirects to: no API call, so no
	# rate limit shared with other jobs on the runner's address.
	v=$(curl -fsSL -o /dev/null -w '%{url_effective}' https://github.com/smallhoursorg/hotserve/releases/latest)
	v=${v##*/}
	from="the latest release's tag"
fi
release "$v" || { not_release "$v" "$from"; exit 1; }
default=${v#v}

# The releases to install, one a line, the default first, then each
# box's, once; and beside them, the files that named each ("<version>
# <file>", one a line), for the line that says a release has no build.
# The boxes are bin/check's: every <host>/Caddyfile tracked or not
# ignored, by name (core.quotePath=false).
versions=$default
named=
if [ -n "$boxes" ]; then
	# One path a line; a name never splits.
	IFS='
'
	for c in $(git -c core.quotePath=false ls-files --cached --others --exclude-standard | grep -E '^[^/]+/Caddyfile$' | LC_ALL=C sort || true); do
		unset IFS
		f=${c%/Caddyfile}/HOTSERVE_VERSION
		[ -e "$f" ] || [ -L "$f" ] || continue
		# $(...) drops the line's newline; anything else is refused.
		if ! v=$(cat "$f" 2>/dev/null); then
			echo "install-hotserve: $f cannot be read: a box's HOTSERVE_VERSION is a regular file of one line, 0.3.1 or v0.3.1-rc1; skipped, and make check refuses this box" >&2
			continue
		fi
		if ! release "$v"; then
			not_release "$v" "$f"
			echo "install-hotserve: $f skipped; make check refuses this box" >&2
			continue
		fi
		v=${v#v}
		named="$named$v $f
"
		printf '%s\n' "$versions" | grep -qxF -- "$v" || versions="$versions
$v"
	done
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cd "$tmp"
# One path a line; a release's version holds no space or newline.
IFS='
'
for v in $versions; do
	unset IFS
	mkdir "$v"
	cd "$v"
	base=https://github.com/smallhoursorg/hotserve/releases/download/v$v
	f=hotserve_${v}_linux_${arch}.tar.gz
	# No build at that address (a release that does not exist, or one
	# without Linux binaries): the default has nothing to fall back to;
	# a box's release is skipped, naming the files that asked for it.
	if ! curl -fsSLO "$base/$f" || ! curl -fsSLO "$base/checksums.txt"; then
		if [ "$v" = "$default" ]; then
			echo "install-hotserve: no release at $base/$f (from $from)" >&2
			exit 1
		fi
		echo "install-hotserve: no release at $base/$f, which $(printf '%s' "$named" | awk -v v="$v" '$1 == v { print $2 }' | paste -s -d , - | sed 's/,/, /g') names; skipped, and make check refuses that box" >&2
		cd ..
		continue
	fi
	# A download that does not match the release's own checksums is
	# nobody's to skip.
	sha256sum -c --ignore-missing checksums.txt
	tar -xzf "$f" hotserve
	sudo install -m 0755 hotserve "/usr/local/bin/hotserve-$v"
	cd ..
	if [ "$v" = "$default" ]; then
		sudo install -m 0755 "$v/hotserve" /usr/local/bin/hotserve
		echo "install-hotserve: hotserve $v ($arch), and hotserve-$v"
	else
		echo "install-hotserve: hotserve-$v ($arch), for the boxes whose HOTSERVE_VERSION names it"
	fi
done
