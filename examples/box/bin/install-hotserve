#!/bin/sh
# Installs the hotserve the workflow checks with, as
# /usr/local/bin/hotserve: the release's bare binary for linux/amd64,
# verified against the release's checksums.txt. Which release:
# HOTSERVE_VERSION (the repository variable, e.g. 0.3.0 or 0.3.0-rc1)
# when it is set, else the latest stable one. Each box validates what it
# is sent with its own binary whatever this installs, so this is only
# the early check.
#
# For the workflow: it installs with sudo. On a laptop, take the
# release's tarball from its page.
set -eu

v=${HOTSERVE_VERSION:-}
v=${v#v}
if [ -z "$v" ]; then
	# Where the latest release's page redirects to: no API call, so no
	# rate limit shared with other jobs on the runner's address.
	v=$(curl -fsSL -o /dev/null -w '%{url_effective}' https://github.com/smallhoursorg/hotserve/releases/latest)
	v=${v##*/v}
fi
bad() {
	echo "install-hotserve: not a hotserve release: '$v' (from HOTSERVE_VERSION, or the latest release's tag)" >&2
	exit 1
}
# Nothing outside the set (a newline included) before the shape check,
# which grep makes per line.
case $v in '' | *[!0-9A-Za-z.-]*) bad ;; esac
printf '%s\n' "$v" | grep -Eqx '[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?' || bad

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cd "$tmp"
base=https://github.com/smallhoursorg/hotserve/releases/download/v$v
f=hotserve_${v}_linux_amd64.tar.gz
curl -fsSLO "$base/$f"
curl -fsSLO "$base/checksums.txt"
sha256sum -c --ignore-missing checksums.txt
tar -xzf "$f" hotserve
sudo install -m 0755 hotserve /usr/local/bin/hotserve
echo "install-hotserve: hotserve $v"
