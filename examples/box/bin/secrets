#!/bin/sh
# The apps' secrets, as commits: each value is one file in this
# repository, encrypted on this laptop with age to the box's own key and
# to every reader's, and the box decrypts it when the push that carries
# it is applied (README.md, Secrets).
#
#   make secret APP=example VAR=DATABASE_URL     set one value: typed at a prompt that
#                                                does not show it, or piped in
#   make secrets                                 the names, and who can read them
#   make secret-show APP=example VAR=DATABASE_URL
#   make rekey                                   encrypt every value again, to the
#                                                readers the recipients file lists now
#   make secrets-import APP=example < env-file   every KEY=VALUE line of an env file
#
#   BOX       the box's directory, <host> (default: the only one here)
#   BOX_KEY   the box's own key, age1…: what `hotserve box key` prints as
#             root on the box. Needed by the first secret of a box, and by
#             make rekey when the box was rebuilt
#   IDENTITY  the private key you read with (default: the key this
#             checkout signs with, from make signer)
#
# Layout, per box:
#
#   <host>/secrets/recipients        who can read: the box's key first, then
#                                    each reader's, one a line, # names them
#   <host>/secrets/<app>/<VAR>.age   one value, encrypted to all of them
#
# A value never touches this laptop's disk: it goes from the prompt or
# the pipe through age into the .age file, and back out only to the
# terminal. Needs git, age (brew install age, apt install age) and
# ssh-keygen.
set -eu
cd "$(dirname "$0")/.."

cmd=${1:-}
[ "$#" -gt 0 ] && shift
case $cmd in
set|show) me=secret ;;
rekey) me=rekey ;;
add-reader) me=signer ;;
*) me=secrets ;;
esac

fail() { printf '%s: %s\n' "$me" "$*" >&2; exit 1; }
say() { printf '%s: %s\n' "$me" "$*"; }

# The box's caps (box/DESIGN-box.md, Caps): an app's env file holds at
# most 64 KiB of variable lines, so a value whose own line,
# VAR="value" and its newline, is longer than that could never be
# installed; and an app has at most 256 variables. The file's size with
# every value in it is the box's to check, and make check's in a pull
# request: only a reader could add the values up here.
max_file=65536
max_vars=256
# An env file to import is read whole before anything is written; one
# far larger than an app's could hold is the wrong file.
max_import=1048576

st=$(mktemp -d)
tty_saved=
cleanup() {
	[ -z "$tty_saved" ] || stty "$tty_saved" </dev/tty 2>/dev/null || true
	rm -rf "$st"
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP

# One path a line; a name never splits.
nl='
'

# The boxes: every <host>/Caddyfile, tracked or about to be, that is
# here (one tracked but deleted is on its way out, as bin/signer and
# bin/check read it).
boxes() {
	git ls-files --cached --others --exclude-standard | grep -E '^[^/]+/Caddyfile$' | LC_ALL=C sort |
		while IFS= read -r bf; do
			[ ! -e "$bf" ] || printf '%s\n' "${bf%/Caddyfile}"
		done
}

# box: BOX, else the only box here.
pick_box() {
	all=$(boxes)
	[ -n "$all" ] || fail "no box here: a box is <host>/Caddyfile at the top of the repository"
	if [ -n "${BOX:-}" ]; then
		box=${BOX%/}
		printf '%s\n' "$all" | grep -qxF -- "$box" ||
			fail "no box $box here: the boxes are $(printf '%s' "$all" | tr '\n' ' ')"
		return
	fi
	case $all in
	*"$nl"*) fail "this repository holds more than one box; name one with BOX=: $(printf '%s' "$all" | tr '\n' ' ')" ;;
	esac
	box=$all
}

# The app grammar is the box's (box/tokens.go, appName), less the one
# name the secrets directory keeps for itself.
check_app() {
	[ -n "${APP:-}" ] || fail "name the app: APP=example"
	case $APP in
	*[!a-z0-9-]*) fail "app '$APP': lower-case letters, digits and - only, as in its app block" ;;
	recipients) fail "app 'recipients': that name is the recipients file's, in the secrets directory" ;;
	esac
	[ "${#APP}" -le 63 ] || fail "app '$APP': at most 63 characters, as in its app block"
}

# A variable's name is what systemd takes in Environment=, as hotserve
# checks it (liveswap/app.go, envKeyRe: ^[A-Za-z_][A-Za-z0-9_]*$), at
# most 128 bytes (box/DESIGN-box.md, Caps).
check_var() {
	[ -n "${VAR:-}" ] || fail "name the variable: VAR=DATABASE_URL"
	case $VAR in
	[0-9]*|*[!A-Za-z0-9_]*) fail "variable '$VAR': letters, digits and _ only, not starting with a digit" ;;
	esac
	[ "${#VAR}" -le 128 ] || fail "variable '$VAR': at most 128 bytes"
}

# An X25519 recipient: age1 and 58 bech32 characters. Not a
# post-quantum one (age1pq1…): age encrypts to those only when every
# recipient is one, and the readers are SSH keys.
check_box_key() {
	case $1 in
	age1*) ;;
	*) return 1 ;;
	esac
	[ "${#1}" -eq 62 ] || return 1
	case ${1#age1} in
	*[!qpzry9x8gf2tvdw0s3jn54khce6mua7l]*) return 1 ;;
	esac
}

short() { printf '%s' "$1" | awk '{ print substr($0, 1, 8) "…" substr($0, length($0) - 3) }'; }

# The box's key, as the recipients file lists it: the first line that is
# not a comment.
box_line() { awk '!/^[[:space:]]*(#|$)/ { print $1; exit }' "$1"; }

# eligible <type> <base64>: whether age can encrypt to an SSH key. age
# takes ssh-ed25519, and ssh-rsa of 2048 bits or more; not the sk-
# hardware forms, not ecdsa.
eligible() {
	case $1 in
	ssh-ed25519) return 0 ;;
	ssh-rsa)
		printf 'ssh-rsa %s\n' "$2" >"$st/rsa.pub"
		bits=$(ssh-keygen -l -f "$st/rsa.pub" 2>/dev/null | awk '{ print $1 }')
		case $bits in ''|*[!0-9]*) return 1 ;; esac
		[ "$bits" -ge 2048 ]
		;;
	*) return 1 ;;
	esac
}

why_not() {
	case $1 in
	ssh-rsa) echo "an RSA key under 2048 bits, which age does not take" ;;
	ecdsa*|sk-ecdsa*) echo "an $1 key, which age cannot encrypt to" ;;
	*) echo "a $1 key, which age cannot encrypt to" ;;
	esac
}

# The signer lines of a box's Caddyfile: principal, type, key.
signers() { awk '$1 == "signer" && NF >= 4 { print $2, $3, $4 }' "$1/Caddyfile"; }

age_note="to read secrets they add an age key of their own to the recipients file (README.md, Secrets)"
first_key="the first key in the recipients file is not a box's (age1 and 58 more characters): the box decrypts with its own key, so that key goes first, as hotserve box key prints it on the box, and the readers after it"

# The recipients file, made at a box's first secret: the box, then every
# signer whose key age takes. Made in $st first, and moved into the
# repository only with the first value (keep_recipients): a value
# refused, or a prompt left, leaves nothing behind. Sets rf, the file,
# and enc, the one to encrypt to now.
ensure_recipients() {
	rf=$box/secrets/recipients
	no_links "$box" "$box/secrets" "$rf"
	enc=$rf
	made=
	given=${BOX_KEY:-}
	given=$(printf '%s' "$given" | tr -d '\r')
	if [ -f "$rf" ]; then
		have=$(box_line "$rf")
		check_box_key "$have" || fail "$first_key"
		if [ -n "$given" ] && [ "$given" != "$have" ]; then
			fail "$rf names the box as $(short "$have"), not BOX_KEY's $(short "$given"); a rebuilt box's secrets move to its new key with make rekey BOX_KEY=$given"
		fi
		return
	fi
	[ -n "$given" ] || fail "$box has no secrets yet, so this first one needs the box's own key: BOX_KEY=\$(ssh root@<your box> hotserve box key)"
	check_box_key "$given" || fail "BOX_KEY is not a box's key: it is age1 and 58 more characters, as \`hotserve box key\` prints it on the box (ssh root@<your box> hotserve box key)"
	readers=
	: >"$st/notes"
	{
		echo "# Who can read the secrets in this directory: every key below."
		echo "# make secret encrypts each value to all of them. The first is the"
		echo "# box's own (hotserve box key, as root on the box); then one line per"
		echo "# reader, under a comment naming them. A reader added here reads"
		echo "# what was there before only after make rekey."
		echo "# $box (the box)"
		echo "$given"
	} >"$st/recipients"
	signers "$box" >"$st/signers"
	while IFS=' ' read -r principal type key; do
		if eligible "$type" "$key"; then
			printf '# %s\n%s %s\n' "$principal" "$type" "$key" >>"$st/recipients"
			readers="$readers, $principal"
		else
			say "$principal signs with $(why_not "$type"); $age_note" >>"$st/notes"
		fi
	done <"$st/signers"
	enc=$st/recipients
	made="made $rf: this box ($(short "$given"))$readers"
}

keep_recipients() {
	[ -n "$made" ] || return 0
	mkdir -p "$box/secrets"
	mv "$st/recipients" "$rf"
	git add -- "$rf"
	cat "$st/notes"
	say "$made"
	made=
}

# The keys in a recipients file: a count, for the messages.
keys_in() { awk '!/^[[:space:]]*(#|$)/' "$1" | wc -l | tr -d ' '; }

# Checks a value, read as od's hex bytes on stdin, and writes the
# value's own bytes to stdout. One trailing newline (LF or CR LF) is
# dropped: what echo and a file's last line end with. Exit 2 empty, 3 a
# line break, 4 a carriage return, 5 a NUL, 6 not UTF-8, 7 too long, 8
# a control character typed at the prompt. The box takes no less: an
# env file holds one line per variable (liveswap/app.go, parseEnvLines).
#
# With typed=1 the bytes are a line typed or pasted at the prompt,
# which reads the terminal raw: its own line editing holds at most 1024
# bytes on macOS and past that drops the rest, Enter included, so a
# long pasted key would never arrive. Raw, nothing is edited: what was
# typed is taken as it is, and a Backspace, an arrow key or any other
# control character refuses the value instead of becoming part of it.
checker='
BEGIN { for (i = 0; i < 256; i++) h[sprintf("%02x", i)] = i; n = 0 }
{ for (i = 1; i <= NF; i++) { b[n++] = h[$i]; if (n > max + 2) { over = 1; exit 7 } } }
END {
	if (over) exit 7
	if (typed) {
		if (n > 0 && b[n - 1] == 10) n--
		for (i = 0; i < n; i++) if (b[i] < 32 || b[i] == 127) exit 8
	}
	if (n > 0 && b[n - 1] == 10) { n--; if (n > 0 && b[n - 1] == 13) n-- }
	if (n == 0) exit 2
	if (n > max) exit 7
	for (i = 0; i < n; i++) {
		if (b[i] == 10) exit 3
		if (b[i] == 13) exit 4
		if (b[i] == 0) exit 5
	}
	for (i = 0; i < n; ) {
		c = b[i]
		if (c < 128) { i++; continue }
		if (c >= 194 && c <= 223) k = 1
		else if (c >= 224 && c <= 239) k = 2
		else if (c >= 240 && c <= 244) k = 3
		else exit 6
		if (i + k >= n) exit 6
		lo = 128; hi = 191
		if (c == 224) lo = 160
		else if (c == 237) hi = 159
		else if (c == 240) lo = 144
		else if (c == 244) hi = 143
		if (b[i + 1] < lo || b[i + 1] > hi) exit 6
		for (j = 2; j <= k; j++) if (b[i + j] < 128 || b[i + j] > 191) exit 6
		i += k + 1
	}
	for (i = 0; i < n; i++) printf "%c", b[i]
}'

# encrypt <name> <recipients> <out> [typed]: the hex bytes on stdin,
# checked, into an age file. A refused value leaves no file. POSIX sh
# has no pipefail, so each side writes its own status down (and
# `|| s=$?` keeps set -e from ending the group before it does).
encrypt() {
	rm -f "$st/chk" "$st/age"
	{ s=0; LC_ALL=C awk -v max="$((max_file - ${#1} - 4))" -v typed="${4:-0}" "$checker" || s=$?; echo "$s" >"$st/chk"; } |
		{ s=0; age -R "$2" -o "$3" 2>"$st/age.err" || s=$?; echo "$s" >"$st/age"; }
	chk=$(cat "$st/chk")
	if [ "$chk" != 0 ]; then
		rm -f "$3"
		case $chk in
		2) fail "$1 is empty: an app's variable that is empty is an env line in its app block, not a secret" ;;
		3) fail "$1 has a line break in it: an env file holds one line per variable" ;;
		4) fail "$1 has a carriage return in it: an env file holds one line per variable" ;;
		5) fail "$1 has a NUL byte in it, which no environment variable can hold" ;;
		6) fail "$1 is not UTF-8 text, which the box hands systemd" ;;
		7) fail "$1 is too long: its line in the env file would be over $max_file bytes, the box's cap for an app's whole env file" ;;
		8) fail "$1 has a control character in it: typing is not shown, so the prompt takes no edits (Backspace, an arrow key); type or paste it again, or pipe it in" ;;
		*) fail "$1 could not be checked (awk exited $chk)" ;;
		esac
	fi
	if [ "$(cat "$st/age")" != 0 ]; then
		rm -f "$3"
		fail "age could not encrypt $1 to $2: $(cat "$st/age.err")"
	fi
}

# The app's block in its box's Caddyfile: none, the env_file line that
# reads its secrets, or another (only a hint: make check and the box
# hold the rules).
env_file_state() {
	awk -v app="$APP" -v want="/etc/hotserve/secrets/$APP.env" '
		function strip(s) { sub(/(^|[[:space:]])#.*/, "", s); return s }
		{
			line = strip($0)
			if (!inapp) {
				if (line ~ "^[[:space:]]*app[[:space:]]+" app "[[:space:]]*\\{") { inapp = 1; depth = 0; found = 1 }
				else next
			}
			if (line ~ /^[[:space:]]*env_file[[:space:]]/) {
				nf = split(line, f, /[[:space:]]+/)
				for (i = 1; i <= nf; i++) if (f[i] == "env_file") { path = f[i + 1]; break }
			}
			o = gsub(/\{/, "{", line); c = gsub(/\}/, "}", line)
			depth += o - c
			if (depth <= 0) inapp = 0
		}
		END {
			if (!found) print "noapp"
			else if (path == want) print "reads"
			else if (path == "") print "none"
			else print "other " path
		}' "$box/Caddyfile"
}

env_file_hint() {
	state=$(env_file_state)
	case $state in
	reads) ;;
	noapp) say "$box/Caddyfile has no app $APP yet: the box takes secrets only for an app its file declares" ;;
	none)
		say "$APP's block does not read its secrets yet; add this line to it:"
		say "    env_file /etc/hotserve/secrets/$APP.env"
		;;
	other*)
		say "$APP's block reads env_file ${state#other }; to read its secrets it needs:"
		say "    env_file /etc/hotserve/secrets/$APP.env"
		;;
	esac
}

# Another file in the app's directory whose name differs only in case
# would be the same file on a Mac's default disk.
# (sh has no local variables: a function's own carry a prefix, so a
# caller's survive the call.)
case_twin() {
	ct_dir=$box/secrets/$APP
	[ -d "$ct_dir" ] || return 0
	ct_lower=$(printf '%s' "$VAR.age" | tr 'A-Z' 'a-z')
	for ct_f in "$ct_dir"/*.age; do
		[ -e "$ct_f" ] || continue
		ct_name=${ct_f##*/}
		[ "$ct_name" = "$VAR.age" ] && continue
		[ "$(printf '%s' "$ct_name" | tr 'A-Z' 'a-z')" != "$ct_lower" ] ||
			fail "$ct_dir/$ct_name differs from $VAR.age only in case: on a Mac's default disk they are one file, and this would overwrite it; use its own name, or git rm it first"
	done
	return 0
}

# install_one <tmp> <target>: an encrypted value into place, and was
# set to added or changed. (Not in a $(...): bash 3.2 runs one without
# set -e.)
install_one() {
	mkdir -p "${2%/*}"
	was=added
	[ ! -e "$2" ] || was=changed
	mv "$1" "$2"
	git add -- "$2"
}

# vars_in <dir>: the .age files there.
vars_in() {
	vi_n=0
	for vi_f in "$1"/*.age; do
		[ ! -e "$vi_f" ] || vi_n=$((vi_n + 1))
	done
	printf '%s' "$vi_n"
}

# The recipients file the values were just encrypted to, staged with
# them, a reader added by hand included: the commit's ciphertext and the
# readers it names agree.
stage_recipients() { git add -- "$box/secrets/recipients"; }

# A symbolic link in a box's secrets is refused, as the box refuses one
# (it takes only directories and regular files there): written through,
# it could reach outside this repository.
no_links() {
	for lk_p in "$@"; do
		[ ! -L "$lk_p" ] || fail "$lk_p is a symbolic link: the box takes none, and writing through one could reach outside this repository; put the file or directory itself there"
	done
}

need_age() {
	command -v age >/dev/null 2>&1 || fail "age is not installed here: brew install age, or apt install age"
}

identity() {
	id=${IDENTITY:-}
	case $id in "~/"*) id=$HOME/${id#"~/"} ;; esac
	if [ -z "$id" ]; then
		id=$(git config user.signingkey || true)
		id=${id%.pub}
	fi
	[ -n "$id" ] && [ -f "$id" ] ||
		fail "no private key to read with: name yours with IDENTITY=~/.ssh/id_ed25519 (or an age identity file); make signer's signing key is used when it is a file"
	printf '%s' "$id"
}

secret_set() {
	need_age
	pick_box
	check_app
	check_var
	ensure_recipients
	target=$box/secrets/$APP/$VAR.age
	no_links "$box/secrets/$APP" "$target"
	case_twin
	[ -e "$target" ] || [ "$(vars_in "$box/secrets/$APP")" -lt "$max_vars" ] ||
		fail "$APP has $max_vars variables, the box's cap for an app"
	# The value is taken as it is, spaces and quotes included: the box
	# writes each one quoted (KEY="value"), which hotserve's env-file
	# parser reads back exactly. Only make secrets-import reads env-file
	# syntax.
	if [ -t 0 ]; then
		tty_saved=$(stty -g)
		stty -echo -icanon min 1 time 0
		printf 'value for %s %s (typing is not shown): ' "$APP" "$VAR" >&2
		# Raw (-icanon) so that a paste of any length arrives (the
		# checker's comment says why), and the same path as a pipe's:
		# from the terminal through head and od to the checker, never a
		# shell variable, which would drop a typed NUL without a word.
		{ head -n 1; printf '\n' >&2; } | od -An -v -tx1 | encrypt "$VAR" "$enc" "$st/value.age" 1
		stty "$tty_saved"
		tty_saved=
	else
		od -An -v -tx1 | encrypt "$VAR" "$enc" "$st/value.age"
	fi
	keep_recipients
	install_one "$st/value.age" "$target"
	stage_recipients
	if [ "$was" = added ]; then
		say "$target, encrypted to $(keys_in "$rf") keys, added to the commit"
	else
		say "$target, encrypted to $(keys_in "$rf") keys: its new value added to the commit"
	fi
	env_file_hint
}

secret_show() {
	need_age
	pick_box
	check_app
	check_var
	f=$box/secrets/$APP/$VAR.age
	no_links "$box" "$box/secrets" "$box/secrets/$APP" "$f"
	[ -f "$f" ] || fail "no $f: make secrets lists what there is"
	id=$(identity)
	age -d -i "$id" "$f" 2>"$st/age.err" || fail "could not read $f with $id: $(cat "$st/age.err")"
	[ ! -t 1 ] || echo
}

secrets_list() {
	all=$(boxes)
	[ -n "$all" ] || fail "no box here: a box is <host>/Caddyfile at the top of the repository"
	[ -z "${BOX:-}" ] || { pick_box; all=$box; }
	for box in $all; do
		rf=$box/secrets/recipients
		echo "$box"
		if [ ! -f "$rf" ]; then
			echo "  no secrets (make secret APP=… VAR=… makes the first)"
			continue
		fi
		readers=$(awk '
			/^[[:space:]]*#/ { name = $0; sub(/^[[:space:]]*#[[:space:]]*/, "", name); next }
			/^[[:space:]]*$/ { next }
			{
				k = $1; if (NF > 1) k = $2
				if (!first) { first = 1; out = "this box (" substr($1, 1, 8) "…" substr($1, length($1) - 3) ")" }
				else out = out ", " (name != "" ? name : substr(k, 1, 12) "…")
				name = ""
			}
			END { print out }' "$rf")
		echo "  readers: $readers"
		for d in "$box"/secrets/*/; do
			[ -d "$d" ] || continue
			app=${d%/}
			app=${app##*/}
			vars=
			for f in "$d"*.age; do
				[ -e "$f" ] || continue
				v=${f##*/}
				vars="$vars ${v%.age}"
			done
			[ -n "$vars" ] || vars=" (none)"
			echo "  $app:$vars"
		done
		signers "$box" >"$st/signers"
		while IFS=' ' read -r principal type key; do
			awk -v k="$key" '$2 == k { f = 1 } END { exit !f }' "$rf" && continue
			if eligible "$type" "$key"; then
				echo "  $principal signs but is not a reader: their make signer adds them, then a reader runs make rekey"
			fi
		done <"$st/signers"
	done
}

secrets_rekey() {
	need_age
	pick_box
	rf=$box/secrets/recipients
	no_links "$box" "$box/secrets" "$rf"
	[ -f "$rf" ] || fail "$box has no secrets to encrypt again"
	check_box_key "$(box_line "$rf")" || fail "$first_key"
	cp "$rf" "$st/recipients"
	if [ -n "${BOX_KEY:-}" ]; then
		given=$(printf '%s' "$BOX_KEY" | tr -d '\r')
		check_box_key "$given" || fail "BOX_KEY is not a box's key: it is age1 and 58 more characters, as \`hotserve box key\` prints it on the box"
		awk -v k="$given" '!done && !/^[[:space:]]*(#|$)/ { print k; done = 1; next } { print }' "$rf" >"$st/recipients"
	fi
	id=$(identity)
	files=
	for f in "$box"/secrets/*/*.age; do
		[ -e "$f" ] || [ -L "$f" ] || continue
		no_links "${f%/*}" "$f"
		files="$files$f$nl"
	done
	[ -n "$files" ] || fail "$box has no secrets to encrypt again"
	# Every value encrypted again into $st first: one that cannot be
	# read changes nothing.
	i=0
	for f in $files; do
		i=$((i + 1))
		rm -f "$st/dec" "$st/enc"
		{ s=0; age -d -i "$id" "$f" 2>"$st/dec.err" || s=$?; echo "$s" >"$st/dec"; } |
			{ s=0; age -R "$st/recipients" -o "$st/$i.age" 2>"$st/enc.err" || s=$?; echo "$s" >"$st/enc"; }
		[ "$(cat "$st/dec")" = 0 ] ||
			fail "could not read $f with $id, so nothing changed: $(cat "$st/dec.err") (a reader of it runs make rekey)"
		[ "$(cat "$st/enc")" = 0 ] || fail "could not encrypt $f again, so nothing changed: $(cat "$st/enc.err")"
	done
	i=0 moved=
	for f in $files; do
		i=$((i + 1))
		mv "$st/$i.age" "$f" || fail "moved into place:${moved:- none}; not $f and those after it: run make rekey again"
		git add -- "$f"
		moved="$moved $f"
	done
	if ! cmp -s "$st/recipients" "$rf"; then
		mv "$st/recipients" "$rf"
		say "$rf now names the box as $(short "$(box_line "$rf")")"
	fi
	stage_recipients
	say "$box: $i secrets encrypted again to $(keys_in "$rf") keys, in the commit"
}

# The env-file parser of hotserve (liveswap/app.go, parseEnvLines), on
# od's hex bytes, so that a byte is a byte whatever awk this is. Per
# line: trim the white space Go's strings.TrimSpace trims (ASCII and
# Unicode's), skip a blank line or one starting #, drop one leading
# "export ", cut at the first =, trim the name and the value, take one
# matching pair of quotes off the value. Prints "NAME hex…" for each
# variable (the last line wins for a name given twice), or the lines it
# refuses, and exits 1; exit 2 is a file over max_import bytes.
parser='
function sp_start(p, e,    c, c1, c2) {
	c = b[p]
	if (c == 32 || (c >= 9 && c <= 13)) return 1
	if (p + 1 < e && c == 194 && (b[p + 1] == 133 || b[p + 1] == 160)) return 2
	if (p + 2 < e) {
		c1 = b[p + 1]; c2 = b[p + 2]
		if (c == 225 && c1 == 154 && c2 == 128) return 3
		if (c == 226 && c1 == 128 && ((c2 >= 128 && c2 <= 138) || c2 == 168 || c2 == 169 || c2 == 175)) return 3
		if (c == 226 && c1 == 129 && c2 == 159) return 3
		if (c == 227 && c1 == 128 && c2 == 128) return 3
	}
	return 0
}
function sp_end(s, e,    c, c0, c1) {
	c = b[e - 1]
	if (c == 32 || (c >= 9 && c <= 13)) return 1
	if (e - 2 >= s && b[e - 2] == 194 && (c == 133 || c == 160)) return 2
	if (e - 3 >= s) {
		c0 = b[e - 3]; c1 = b[e - 2]
		if (c0 == 225 && c1 == 154 && c == 128) return 3
		if (c0 == 226 && c1 == 128 && ((c >= 128 && c <= 138) || c == 168 || c == 169 || c == 175)) return 3
		if (c0 == 226 && c1 == 129 && c == 159) return 3
		if (c0 == 227 && c1 == 128 && c == 128) return 3
	}
	return 0
}
function trim(s, e,    k) {
	while (s < e && (k = sp_start(s, e)) > 0) s += k
	while (e > s && (k = sp_end(s, e)) > 0) e -= k
	TS = s; TE = e
}
function refuse(num, why) { print "line " num ": " why > "/dev/stderr"; bad = 1 }
function one(s, e, num,    q, ks, ke, vs, ve, i, c, name, hex) {
	trim(s, e); s = TS; e = TE
	if (s == e || b[s] == 35) return
	if (e - s >= 7 && b[s] == 101 && b[s + 1] == 120 && b[s + 2] == 112 && b[s + 3] == 111 && b[s + 4] == 114 && b[s + 5] == 116 && b[s + 6] == 32) s += 7
	for (q = s; q < e && b[q] != 61; q++) ;
	if (q == e) { refuse(num, "not KEY=VALUE"); return }
	trim(s, q); ks = TS; ke = TE
	if (ks == ke) { refuse(num, "not KEY=VALUE"); return }
	name = ""
	for (i = ks; i < ke; i++) {
		c = b[i]
		if (!((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || (c >= 48 && c <= 57 && i > ks))) {
			refuse(num, "the name is not letters, digits and _, not starting with a digit"); return
		}
		name = name sprintf("%c", c)
	}
	if (ke - ks > 128) { refuse(num, name " is longer than 128 bytes"); return }
	trim(q + 1, e); vs = TS; ve = TE
	if (ve - vs >= 2 && ((b[vs] == 34 && b[ve - 1] == 34) || (b[vs] == 39 && b[ve - 1] == 39))) { vs++; ve-- }
	if (vs == ve) { refuse(num, name " is empty: an empty variable is an env line in the app block, not a secret"); return }
	low = tolower(name)
	if ((low in lc) && lc[low] != name) {
		refuse(num, name " and " lc[low] " differ only in case: on the default disk of a Mac they are one file"); return
	}
	lc[low] = name
	if (!(name in vs_)) order[++count] = name
	else seen[name] = seen[name] " " num
	vs_[name] = vs; ve_[name] = ve
}
BEGIN { for (i = 0; i < 256; i++) h[sprintf("%02x", i)] = i; n = 0 }
{ for (i = 1; i <= NF; i++) { b[n++] = h[$i]; if (n > maxin) { over = 1; exit 2 } } }
END {
	if (over) exit 2
	s = 0; num = 0
	for (p = 0; p <= n; p++) {
		if (p < n && b[p] != 10) continue
		num++
		one(s, p, num)
		s = p + 1
	}
	if (bad) exit 1
	for (i = 1; i <= count; i++) {
		nm = order[i]
		if (nm in seen) print "note: " nm " is given again on line" seen[nm] "; the last one is kept" > "/dev/stderr"
		printf "%s", nm
		for (j = vs_[nm]; j < ve_[nm]; j++) printf " %02x", b[j]
		printf "\n"
	}
}'

secrets_import() {
	need_age
	pick_box
	check_app
	no_links "$box" "$box/secrets" "$box/secrets/$APP"
	[ ! -t 0 ] || fail "pipe an env file in: make secrets-import APP=$APP < $APP.env, or ssh root@<your box> cat /etc/hotserve/$APP.env | make secrets-import APP=$APP"
	# The values stay in this shell's memory, as hex: never in a file.
	ps=0
	records=$(od -An -v -tx1 | LC_ALL=C awk -v maxin="$max_import" "$parser" 2>"$st/parse.err") || ps=$?
	[ "$ps" != 2 ] || fail "the file is over $max_import bytes, far more than an app's env file can hold (64 KiB): nothing imported"
	if [ "$ps" != 0 ]; then
		sed "s/^/$me: /" "$st/parse.err" >&2
		fail "nothing imported"
	fi
	sed "s/^/$me: /" "$st/parse.err" >&2
	[ -n "$records" ] || fail "the env file has no KEY=VALUE line: nothing imported"
	# Every name checked against what is there before anything is
	# written: a case twin, and the box's cap on an app's variables.
	new=0
	for rec in $records; do
		name=${rec%% *}
		VAR=$name
		no_links "$box/secrets/$APP/$name.age"
		case_twin
		[ -e "$box/secrets/$APP/$name.age" ] || new=$((new + 1))
	done
	[ $(($(vars_in "$box/secrets/$APP") + new)) -le "$max_vars" ] ||
		fail "$APP would have more than $max_vars variables, the box's cap for an app: nothing imported"
	ensure_recipients
	# All encrypted first, then moved into place: a refused value
	# imports nothing.
	i=0
	for rec in $records; do
		i=$((i + 1))
		name=${rec%% *}
		printf '%s\n' "${rec#"$name"}" | encrypt "$name" "$enc" "$st/$i.age"
	done
	keep_recipients
	i=0 added= changed=
	for rec in $records; do
		i=$((i + 1))
		name=${rec%% *}
		install_one "$st/$i.age" "$box/secrets/$APP/$name.age"
		if [ "$was" = added ]; then added="$added $name"; else changed="$changed $name"; fi
	done
	stage_recipients
	records=
	[ -z "$added" ] || say "$box/secrets/$APP: added$added"
	[ -z "$changed" ] || say "$box/secrets/$APP: changed$changed"
	say "$i values, encrypted to $(keys_in "$rf") keys, in the commit"
	env_file_hint
}

# How someone whose signing key age cannot read with reads instead.
age_key_howto() {
	say "  make an age key (age-keygen -o ~/.config/age/hotserve.txt, or age-plugin-yubikey / age-plugin-se for one held in hardware),"
	say "  add its age1… line under '# $1' in each <host>/secrets/recipients, have a reader run make rekey,"
	say "  and read with make secret-show IDENTITY=~/.config/age/hotserve.txt"
}

# add-reader <principal> <type> <key> [file|agent], from bin/signer: the
# key into every box's recipients file that exists, when age takes it.
# agent: the private half is not a file beside the .pub, and age
# decrypts only with a key file.
add_reader() {
	principal=$1 type=$2 key=$3 holder=${4:-file}
	all=$(boxes)
	any=
	for box in $all; do
		rf=$box/secrets/recipients
		no_links "$box/secrets" "$rf"
		[ -f "$rf" ] || continue
		any=1
		eligible "$type" "$key" || continue
		if awk -v k="$key" '$2 == k { f = 1 } END { exit !f }' "$rf"; then
			say "$rf already lists this key as a reader"
			continue
		fi
		clean=0
		git ls-files --error-unmatch -- "$rf" >/dev/null 2>&1 &&
			git diff --quiet -- "$rf" && git diff --cached --quiet -- "$rf" && clean=1
		# A file edited by hand may end without a newline.
		[ -z "$(tail -c 1 "$rf")" ] || echo >>"$rf"
		printf '# %s\n%s %s\n' "$principal" "$type" "$key" >>"$rf"
		say "added $principal to $rf as a reader; the secrets already there become readable to them after a reader runs make rekey"
		if [ "$clean" = 1 ]; then
			git add -- "$rf"
		else
			say "$rf has other edits, or is not committed yet, so it is not staged: git add -p it"
		fi
	done
	if [ -n "$any" ] && ! eligible "$type" "$key"; then
		say "this key is $(why_not "$type"), so it cannot read the boxes' secrets:"
		age_key_howto "$principal"
	elif [ -n "$any" ] && [ "$holder" = agent ]; then
		say "an agent holds this key, with no file beside the .pub, and age decrypts only with a key file: the secrets are encrypted to it, but to read them here:"
		age_key_howto "$principal"
	fi
	return 0
}

IFS=$nl
case $cmd in
set) secret_set ;;
show) secret_show ;;
list) secrets_list ;;
rekey) secrets_rekey ;;
import) secrets_import ;;
add-reader)
	[ "$#" -eq 3 ] || [ "$#" -eq 4 ] || fail "usage: bin/secrets add-reader <principal> <type> <key> [file|agent]"
	add_reader "$@"
	;;
*) fail "usage: bin/secrets set|show|list|rekey|import (make secret, secret-show, secrets, rekey, secrets-import)" ;;
esac
