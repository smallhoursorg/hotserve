# /etc/sudoers.d/hotserve-admin — what an administrator needs for the
# apps' secrets.
#
# Members of the hotserve-admin group can run exactly these commands as
# root, and nothing else: creating an app's env file and editing it.
# The Caddyfile is not theirs: it changes only by a signed push from the
# box's repository. Everything else an administrator does needs no
# privilege at all: `hotserve validate`, reading the config, and — with
# membership of the adm group — the journal, hotserve's and every app's.
#
# What this grants: the environment of every app whose env_file names
# a file under /etc/hotserve, read at the app's next launch — and for
# most runtimes an environment variable (NODE_OPTIONS, say) is a way to
# run code as that app. Not the Caddyfile, and not the hotserve user.
#
# Install:  sudo install -m 0440 sudoers /etc/sudoers.d/hotserve-admin
#           sudo groupadd hotserve-admin
#           sudo usermod -aG adm,hotserve-admin <user>
#
# Anchored regex, not a glob: in sudoers a * would also match "/", and
# so admit /etc/hotserve/../elsewhere/x.env. The install line creates
# an env file: empty, 0640 root:hotserve, under /etc/hotserve — every
# argument but the name is literal, and the regex spans the whole
# argument string, so a second path, another mode or another owner
# does not match. -T makes the last argument the file itself: without
# it, install would treat an existing directory of that name as the
# place to put a file called "null".
Cmnd_Alias HOTSERVE_SECRETS = \
	sudoedit ^/etc/hotserve/[A-Za-z0-9_-]+\.env$, \
	/usr/bin/install ^-m 0640 -o root -g hotserve -T /dev/null /etc/hotserve/[A-Za-z0-9_-]+\.env$
%hotserve-admin ALL=(root) NOPASSWD: HOTSERVE_SECRETS
