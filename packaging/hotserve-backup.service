# Backs up what each liveswap app declares as `state`.
#
# This unit does the deciding, not the copying: it asks hotserve's
# admin API which apps declare state and then starts one transient,
# sandboxed unit per app (hotserve-backup-<app>.service), each of
# which can see only that app's shared dir — read-only — and its own
# staging dir. Creating those units is why this runs as root; nothing
# it starts does.
#
# It is inert until /etc/hotserve/backup.env names a repository, so
# installing the package turns nothing on. `hotserve backup init`
# writes that file.
#
# Deliberately not here: retention. `restic forget` deletes from the
# repository, and the credentials on a box should not be able to —
# see docs/backups.md, "Keep the box unable to delete".

[Unit]
Description=hotserve backups
Documentation=https://github.com/smallhoursorg/hotserve/blob/main/docs/backups.md
After=hotserve.service
# Nothing to do when backups were never configured; the timer then
# fires into a unit that skips, rather than one that fails every hour.
ConditionPathExists=/etc/hotserve/backup.env

[Service]
Type=oneshot
ExecStart=/usr/bin/hotserve backup run
# No timeout, here or on the jobs: the first backup of a large uploads
# dir over a slow uplink takes hours, and a job cut off part-way makes
# the next one upload everything again. A hung connection is restic's
# to bound (its per-request timeout); systemd does not start a timer's
# unit while it is still active, so a long run costs missed hours, not
# overlapping ones.
TimeoutStartSec=infinity
# The per-app jobs are transient units of their own, outside this one's
# cgroup. Stopping this unit stops the job it is waiting on, because the
# command does that itself when it is told to stop (RunAll, backup/run.go)
# — that one unit, by name, and no other. Nothing here stops units by
# pattern: an app's unit name is also an operator's restore of that app
# and a first backup run by hand, and a stop that reached those at the
# end of every hourly run would leave a restore half done. A job this
# unit did not get to stop (it was killed outright) finishes by itself,
# and until then the next hour finds that app's name taken and says so.
# Backups are background work: they yield to whatever is serving.
Nice=10
IOSchedulingClass=idle

# This unit is root for one thing: asking systemd for units that systemd
# gives the credential to (DESIGN-threat-model.md, "Backups"). What it
# is not for is held to here, by systemd rather than by the code keeping
# a promise: the filesystem is read-only to it, the staging dirs and
# hotserve's own state are not there at all, and it has no network — the
# admin API and systemd are both unix sockets. It reads the admin API's
# answer, which the hotserve process wrote; this is what a fault in
# reading it has to work with.
#
# One capability is left of root's forty: the admin socket is writable
# by its owner alone (Caddy makes it so), in a directory that is
# hotserve's, and only CAP_DAC_OVERRIDE connects to it from here. On a
# read-only filesystem it opens files to read and sockets to connect to,
# and changes nothing.
#
# (Not a boundary against this unit being taken over outright: whatever
# may ask systemd for a transient unit may ask for one that is root.)
CapabilityBoundingSet=CAP_DAC_OVERRIDE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077
# Where the jobs write, and hotserve's own state (its TLS keys): this
# unit has no business in either, so neither is in its view.
InaccessiblePaths=-/var/lib/hotserve-backup -/var/lib/hotserve-backup-status -/var/lib/hotserve
# Nor is the credential. The settings file is systemd's to read, for the
# units this one asks for; here it is an empty file that exists, which
# is all the launcher looks for (measured: it reads as nothing even with
# the capability above, and a unit started from here still gets the
# values).
InaccessiblePaths=-/etc/hotserve/backup.env
