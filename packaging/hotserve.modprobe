# Installed by hotserve as /usr/lib/modprobe.d/hotserve.conf.
#
# Kernel modules no app may load. An app unit's RestrictAddressFamilies=
# admits AF_INET and AF_INET6 with any protocol number, and the kernel
# loads a protocol's module on the first socket() that names it, as
# any user. On Debian 13's 6.12 three protocols carry that alias and
# gate nothing at creation: sctp (protocol 132), l2tp_ip and l2tp_ip6
# (115) and smc (256). A compromised app would get a live socket into
# kernel code the sandbox meant to keep out. dccp, tipc and rds load
# only by root's hand (Debian strips dccp's and rds's autoload aliases;
# tipc never had one), and the three lines refuse that too: a loaded
# tipc is configurable by any netlink sender, and the seven together
# are the set the CIS Debian benchmark makes unavailable.
# liveswap/DESIGN-sandbox.md, "Module-backed protocols", holds the
# measurement and the triage.
#
# `install <module> /bin/false` stops the kernel's autoload and a hand
# `modprobe <module>` alike, a module depending on it with them
# (`modprobe dccp_ipv4` stops at dccp's line), and names the refusal.
# Nothing a hotserve box runs needs any of them. An operator who does
# need them puts a file named hotserve.conf in /etc/modprobe.d/, which
# masks this one whole (modprobe.d(5)); a module already loaded stays
# until reboot.
install dccp /bin/false
install sctp /bin/false
install l2tp_ip /bin/false
install l2tp_ip6 /bin/false
install smc /bin/false
install tipc /bin/false
install rds /bin/false
