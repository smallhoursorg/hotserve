# e2e only: mints the local deploy keypair + token into /shared before
# hotserve starts (see e2e/mint-token.sh).
[Unit]
Description=e2e: mint the local deploy token
Before=hotserve.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/mint-token.sh

[Install]
WantedBy=multi-user.target
