# e2e only: load the hotserve-user-manager AppArmor profile at boot.
# On a real host apparmor.service does this from /etc/apparmor.d; in a
# container it deliberately does nothing (Debian's init skips policy
# loading under systemd-detect-virt --container), and the package's
# postinstall — which loads the profile live at install time — ran at
# image build here, with no kernel to load into. Ordered before
# sysinit.target so user@<uid>.service, which attaches to the profile
# by path, starts after it. Skipped where AppArmor is absent.
[Unit]
Description=e2e: load the hotserve-user-manager AppArmor profile
DefaultDependencies=no
ConditionSecurity=apparmor
ConditionPathExists=/sys/kernel/security/apparmor/.load
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/apparmor_parser -r /etc/apparmor.d/hotserve-user-manager

[Install]
WantedBy=sysinit.target
