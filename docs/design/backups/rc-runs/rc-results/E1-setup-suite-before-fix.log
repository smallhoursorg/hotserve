logs=$(mktemp -d); i=0; \
	for s in setup; do \
		i=$((i + 1)); \
		( t0=$(date +%s); docker compose exec -T --index $i e2e-backup-box timeout 600 /bin/sh /suite-$s.sh >$logs/$s.log 2>&1; echo "$? $(($(date +%s) - t0))" >$logs/$s.rc ) & \
	done; \
	wait; \
	status=0; i=0; \
	for s in setup; do \
		i=$((i + 1)); \
		rc=; took=; read rc took <$logs/$s.rc || rc=unknown; \
		echo "════ $s suite (box $i, ${took:-?}s) ════"; \
		cat $logs/$s.log; \
		if [ "$rc" = 124 ]; then echo "════ $s suite ended at SUITE_LIMIT (600s) ════"; fi; \
		if [ "$rc" != 0 ]; then \
			status=1; \
			echo "════ $s suite failed: box $i's journal ════"; \
			docker compose exec -T --index $i e2e-backup-box journalctl --no-pager -n 200 || true; \
		fi; \
	done; \
	if [ $status -ne 0 ]; then docker compose logs --tail 300 e2e-s3; fi; \
	rm -rf $logs; \
	docker compose rm -sf e2e-backup-box e2e-s3 >/dev/null; \
	exit $status
